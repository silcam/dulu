<style>
  .container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .topBar {
    background-color: #000;
    padding: 8px;
  }

  .main {
    flex-grow: 1;
    padding: 0 16px;
  }

  .lead {
    font-size: 22px;
  }

  .red {
    color: #A93226;
  }

  hr {
    border: 0;
    border-top: 1px solid #eee;
    margin: 12px;
  }

  ul.list-inline li {
    display: inline-block;
    padding: 12px;
  }
</style>

<div class="container">
  <div class="topBar">
    <%= image_tag 'dulu.png', alt: 'Dulu '%>
  </div>
  <div class="main">
      <h1 class="welcome"><strong>Welcome to Dulu</strong></h1>

      <p class="lead welcome">Dulu is a tool developed by SIL Cameroon for tracking and managing the many language development languages in Cameroon. To gain access, contact the Cameroon Branch Computer Services Department.</p>

    <% if @failed_login_email %>
        <p class="lead red">
          Sorry, but no one is authorized to log in to Dulu with the address <%= @failed_login_email %>. Are you using the correct SIL email address?
        </p>
    <% end %>

      <%# This was a <p class="welcome">. button_to emits a <form>, which is not
          phrasing content, so a browser silently closes the <p> before it and
          the padding is lost. A div holds the same class with no such rule. %>
      <div class="welcome">
        <%# OmniAuth 2 requires the request phase to be a POST carrying a CSRF
            token (omniauth-rails_csrf_protection verifies it). This was an
            <a href>, which OmniAuth 2 refuses. button_to gives a real form;
            the button is unstyled on purpose so the three image_tag states
            below keep working exactly as they did. %>
        <%= button_to "/auth/google_oauth2", id: 'google-signin-link',
                      class: 'google-signin-button' do %>
          <%= image_tag 'btn_google_signin_light_normal_web@2x.png', class: 'img-normal', size: '287x69', alt: 'Sign in with Google' %>
          <%= image_tag 'btn_google_signin_light_focus_web@2x.png', class: 'img-focus', size: '287x69', alt: 'Sign in with Google' %>
          <%= image_tag 'btn_google_signin_light_pressed_web@2x.png', class: 'img-pressed', size: '287x69', alt: 'Sign in with Google' %>
        <% end %>
      </div>

  </div>
  <div>
    <hr>
    <ul class="list-inline">
      <li class="lead"><%= link_to 'SIL Cameroon', 'http://cameroon.sil.org' %></li>
      <li class="lead"><%= link_to 'SIL International', 'http://sil.org' %></li>
      <li class="lead"><%= link_to 'Wycliffe Global Alliance', 'http://wycliffe.net' %></li>
      <li class="lead"><%= link_to 'Ethnologue', 'http://ethnologue.com' %></li>
    </ul>
  </div>
</div>