{
    "compilerOptions": {
      "allowJs": true,
      "allowSyntheticDefaultImports": true,
      "checkJs": false,
      "declaration": false,
      "lib": ["esnext", "dom"],
      "module": "es6",
      "moduleResolution": "node",
      "noEmit": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      // See the note in tsconfig.json. Tests additionally need Jest's globals
      // (describe/it/expect), so those are named explicitly rather than picked up by
      // scanning all of node_modules/@types.
      "types": ["jest"],
      "sourceMap": true,
      "target": "es3",
      "jsx": "react",
      "strict": true
    },
    "include": [
      "**/*.spec.ts"
    ],
    "exclude": [
      "spec",
      "node_modules",
      "vendor",
      "public"
    ],
    "compileOnSave": true
  }
  
