{
    "compilerOptions": {
      "allowJs": true,
      "allowSyntheticDefaultImports": true,
      "checkJs": false,
      "declaration": false,
      "lib": ["esnext", "dom"],
      "module": "es6",
      "moduleResolution": "node",
      "noEmit": true,
      "resolveJsonModule": true,
      // ts-jest emits CommonJS, so default-importing a JSON module needs the interop
      // helper -- see the note in app/javascript/i18n/i18n.ts. Deliberately not set in
      // tsconfig.json: the webpack build emits ESM and does not need it, and turning it on
      // there would change emit for every module in the app.
      "esModuleInterop": true,
      "skipLibCheck": true,
      // See the note in tsconfig.json. Tests additionally need Jest's globals
      // (describe/it/expect), so those are named explicitly rather than picked up by
      // scanning all of node_modules/@types.
      "types": ["jest"],
      "sourceMap": true,
      "target": "es2019",
      "jsx": "react",
      "strict": true
    },
    // "test", not "**/*.spec.ts". The old pattern matched *nothing*: there is not one
    // .spec.ts in the repo -- the Jest tests are *.test.ts/.tsx/.js, and the Cypress
    // specs are .spec.js under spec/, which is excluded below. So `tsc -p` on this file
    // failed with TS18003 ("No inputs were found"), and the only thing keeping it alive
    // was ts-jest, which reads compilerOptions and ignores include entirely.
    //
    // Now that it names real files, `yarn typecheck` runs it as a second program; see
    // the note on that script in package.json.
    "include": [
      "test",
      // The ambient module declarations. The app config has no `include` at all, so it
      // sweeps these up with everything else; this program is scoped to `test`, and a
      // scoped program does not pick up .d.ts files outside it. Without this line every
      // app component a test imports fails on its `import styles from "./Foo.css"`.
      "app/javascript/types"
    ],
    "exclude": [
      "spec",
      "node_modules",
      "vendor",
      "public"
    ],
    "compileOnSave": true
  }
  
