{
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "test:js": "jest --watch",
    "test:rails": "nodemon --exec \"bin/rails test\" -e rb,yml,jbuilder --watch app --watch test",
    "test:most": "rails test && yarn jest",
    "test:all": "rails test && yarn jest && yarn test:cypress:run",
    "test:all:mod": "rails test && yarn jest && yarn test:cypress",
    "testServer": "bin/rails server -e test -p 3002",
    "test:cypress": "concurrently -p \"[{name}]\" -n \"Server,Cypress\" -k -c yellow,green \"yarn testServer\" \"yarn cypress open --project ./spec\"",
    "test:cypress:run": "concurrently -p \"[{name}]\" -n \"Server,Cypress\" -k -s last -c yellow,green \"yarn testServer\" \"yarn cypress run --project ./spec\"",
    "test:cypress:gate": "yarn testPacks && concurrently -p \"[{name}]\" -n \"Server,Cypress\" -k -s last -c yellow,green \"yarn testServer\" \"yarn cypress run --project ./spec\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "testPacks": "RAILS_ENV=test bin/rails shakapacker:compile"
  },
  "resolutions": {
    "//": "@types/react-redux, @types/react-tabs and @types/hoist-non-react-statics all depend on \"@types/react\": \"*\", which resolves to 19. A second copy of the React types in the tree makes every connect()-wrapped and react-tabs component fail with TS2786 -- the ReactElement from one copy is not the ReactNode of the other. Pin the whole tree to one major.",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  },
  "dependencies": {
    "@babel/core": "^7.21.4",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/preset-env": "^7.21.4",
    "@babel/preset-react": "^7.12.13",
    "@babel/runtime": "^7.21.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axios": "^1.13.2",
    "babel-loader": "^8.3.0",
    "babel-plugin-macros": "^3.1.0",
    "compression-webpack-plugin": "^9.2.0",
    "core-js": "^3.6.5",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^4.2.2",
    "immutability-helper": "^3.1.1",
    "mini-css-extract-plugin": "^2.7.5",
    "prop-types": "^15.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "6.30.6",
    "react-tabs": "^6.1.0",
    "redux": "^5.0.1",
    "regenerator-runtime": "^0.13.7",
    "shakapacker": "10.3.2",
    "style-loader": "^3.3.2",
    "terser-webpack-plugin": "^5.3.7",
    "ts-loader": "^9.4.2",
    "typescript": "^5.4.5",
    "webpack": "^5.101.0",
    "webpack-assets-manifest": "^5.1.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.0",
    "concurrently": "^9.2.1",
    "cypress": "15.21.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.70.0",
    "webpack-dev-server": "^5.2.2"
  },
  "browserslist": [
    "defaults"
  ],
  "jest": {
    "preset": "ts-jest/presets/js-with-babel",
    "//": "ts-jest 29 takes its options from the transform entry, not from `globals`, and the option is `tsconfig` (the old `tsConfig` spelling is gone). The key matches the js-with-babel preset's own ts key exactly, so this overrides that entry rather than adding a second one -- jest merges a preset's transform map with the config's, and .js still goes through babel-jest.",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "roots": [
      "test/javascript",
      "app/javascript"
    ],
    "moduleDirectories": [
      "node_modules",
      "app/javascript"
    ],
    "moduleNameMapper": {
      "\\.png$": "<rootDir>/test/javascript/__mocks__/fileMock.js",
      "\\.css$": "<rootDir>/test/javascript/__mocks__/styleMock.js"
    }
  }
}
